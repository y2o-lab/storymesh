{
  "name": "storymesh-nextjs-blog-demo",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006 --host 127.0.0.1 --no-open",
    "build-storybook": "storybook build",
    "storybook:index": "node scripts/index.mjs",
    "storymesh:check": "storymesh check src/components --framework react",
    "storymesh:coverage": "storymesh coverage src/components --framework react",
    "storymesh:report": "storymesh report src/components --framework react",
    "storymesh:spec": "storymesh spec check --spec-dir .storymesh/specs --index storybook-static/index.json",
    "demo:reset": "node scripts/scenario.mjs reset",
    "demo:complete": "node scripts/scenario.mjs complete",
    "demo:exercise": "node scripts/exercise.mjs",
    "demo:capture": "node scripts/capture.mjs"
  },
  "dependencies": {
    "next": "16.4.0",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "storymesh": "0.1.0",
    "storybook": "10.6.2",
    "@storybook/nextjs-vite": "10.6.2",
    "@storybook/addon-docs": "10.6.2",
    "typescript": "6.0.2",
    "@types/node": "24.13.2",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "playwright": "1.61.1"
  }
}
